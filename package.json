{
  "name": "iconkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "start": "node packages/cli/bin/iconkit.js",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @icon-kit/core build && pnpm -r --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:pack": "pnpm build && node scripts/package-smoke.js",
    "benchmark": "pnpm --filter @icon-kit/core build && node scripts/benchmark-generation.js",
    "build": "pnpm -r --if-present run build",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @icon-kit/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/icons": "1.50.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
