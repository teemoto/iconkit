{
  "name": "@icon-kit/core",
  "version": "0.1.0-alpha.0",
  "description": "Deterministic IconKit asset-generation engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teemoto/iconkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/teemoto/iconkit/issues"
  },
  "homepage": "https://github.com/teemoto/iconkit#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": "./node.js",
    "./wasm/*": "./dist/wasm/*"
  },
  "files": [
    "dist",
    "licenses",
    "README.md",
    "LICENSE",
    "NOTICE",
    "node.js"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/copy-wasm.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3"
  }
}
